{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git blame)",
      "Bash(git blame *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git remote -v)",
      "Bash(git remote -v *)",
      "Bash(git stash list)",
      "Bash(git stash list *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(fd)",
      "Bash(fd *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(which)",
      "Bash(which *)",
      "Bash(scc)",
      "Bash(scc *)",
      "Bash(go build)",
      "Bash(go build *)",
      "Bash(go test)",
      "Bash(go test *)",
      "Bash(go vet)",
      "Bash(go vet *)",
      "Bash(go list)",
      "Bash(go list *)",
      "Bash(go doc)",
      "Bash(go doc *)",
      "Bash(go env)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(go version *)",
      "Bash(go mod tidy)",
      "Bash(go mod tidy *)",
      "Bash(go mod download)",
      "Bash(go mod download *)",
      "Bash(go mod verify)",
      "Bash(go mod verify *)",
      "Bash(gotestsum)",
      "Bash(gotestsum *)",
      "Bash(golangci-lint run)",
      "Bash(golangci-lint run *)",
      "Bash(gofumpt -l)",
      "Bash(gofumpt -l *)",
      "Bash(gofumpt -d)",
      "Bash(gofumpt -d *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest)",
      "Bash(uv run python -m pytest *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv tree)",
      "Bash(uv tree *)",
      "Bash(ruff check)",
      "Bash(ruff check *)",
      "Bash(ruff format --check)",
      "Bash(ruff format --check *)",
      "Bash(ruff format --diff)",
      "Bash(ruff format --diff *)",
      "Bash(pyright)",
      "Bash(pyright *)",
      "Bash(uv run pyright)",
      "Bash(uv run pyright *)",
      "Bash(shellcheck)",
      "Bash(shellcheck *)",
      "Bash(shfmt -d)",
      "Bash(shfmt -d *)",
      "Bash(shfmt -l)",
      "Bash(shfmt -l *)",
      "Bash(bats)",
      "Bash(bats *)",
      "Bash(ansible-lint)",
      "Bash(ansible-lint *)",
      "Bash(yamllint)",
      "Bash(yamllint *)",
      "Bash(ansible-playbook --syntax-check)",
      "Bash(ansible-playbook --syntax-check *)",
      "Bash(terraform fmt -check)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform validate)",
      "Bash(terraform validate *)",
      "Bash(tflint)",
      "Bash(tflint *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "Bash(tsc --noEmit)",
      "Bash(tsc --noEmit *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make lint)",
      "Bash(make lint *)",
      "Bash(make check)",
      "Bash(make check *)",
      "Bash(make build)",
      "Bash(make build *)",
      "Bash(just test)",
      "Bash(just test *)",
      "Bash(just lint)",
      "Bash(just lint *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aidev-notify",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aidev-notify",
            "timeout": 10
          }
        ]
      }
    ]
  }
}