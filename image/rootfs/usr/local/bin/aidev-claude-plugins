#!/usr/bin/env bash
# Ставит маркетплейсы и плагины Claude Code в ~/.claude (общий том aidev-claude).
# Вызывается из postCreateCommand (метаданные образа); идемпотентен, ошибки не фатальны.
#
#   AIDEV_CLAUDE_MARKETPLACES  — источники через пробел (URL git / owner/repo / путь)
#   AIDEV_CLAUDE_PLUGINS       — плагины через пробел (plugin@marketplace)
#
# В devcontainer.json проекта: "containerEnv": {"AIDEV_CLAUDE_PLUGINS": "gsd-core@gsd-core other@mp"}
# Обновить установленное:  aidev-claude-plugins --update
set -uo pipefail

# Плагины/маркетплейсы с source "github" Claude клонирует по SSH, если github.com есть в
# known_hosts (а он там есть) — без SSH-ключа это падает. Для этого скрипта все
# GitHub-клоны идут по HTTPS; глобальный git config не трогаем.
export GIT_CONFIG_COUNT=2 \
    GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf   GIT_CONFIG_VALUE_0=git@github.com: \
    GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf   GIT_CONFIG_VALUE_1=ssh://git@github.com/

claude="$(command -v claude || echo "$HOME/.local/bin/claude")"
[ -x "$claude" ] || { echo "aidev-claude-plugins: claude not found, skip"; exit 0; }

# run DESCRIPTION CMD... — с одной повторной попыткой; полный вывод только при ошибке
rc=0
run() {
    local what="$1" out; shift
    for attempt in 1 2; do
        if out="$("$@" </dev/null 2>&1)"; then
            printf 'aidev-claude-plugins: %s: %s\n' "$what" "$(printf '%s\n' "$out" | grep -m1 '✔' || echo ok)"
            return 0
        fi
        [ "$attempt" = 1 ] && sleep 5
    done
    printf 'aidev-claude-plugins: WARN %s failed:\n%s\n' "$what" "$out"
    rc=1
}

mode=install
[ "${1:-}" = --update ] && mode=update

for src in ${AIDEV_CLAUDE_MARKETPLACES:-}; do
    run "marketplace $src" "$claude" plugin marketplace add "$src"
done
[ "$mode" = update ] && run "marketplace update" "$claude" plugin marketplace update

for p in ${AIDEV_CLAUDE_PLUGINS:-}; do
    run "$mode $p" "$claude" plugin "$mode" "$p" --scope user
done

[ "$rc" -eq 0 ] || echo "aidev-claude-plugins: some steps failed (offline?) — rerun: aidev-claude-plugins"
exit 0
